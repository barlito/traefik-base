# Environment: local or production
ENV=local

# Dashboard Configuration
DASHBOARD_HOST=traefik.local.barlito.fr

# Authelia
# Generate each secret with: openssl rand -base64 32
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
# Wrap in SINGLE quotes (argon2 hashes contain $)!
# Generate with: docker run --rm authelia/authelia:4 authelia crypto hash generate argon2 --password 'your-password'
AUTHELIA_USER_PASSWORD_HASH=

# WireGuard VPN (used by docker-compose.wireguard.yml)
# Public IP or domain of the server (required)
WG_HOST=
WG_PORT=51820
WG_DEFAULT_DNS="1.1.1.1, 8.8.8.8"
# Full tunnel (or use server subnet for split tunnel)
WG_ALLOWED_IPS=0.0.0.0/0
WG_PERSISTENT_KEEPALIVE=25

# Let's Encrypt Configuration (production only)
ACME_EMAIL=

# fail2ban (used by docker-compose.fail2ban.yml)
TZ=Europe/Paris
